---
// One stdlib segment (an op `category`), from the descriptor at build time: signature,
// description, and every example - RUN, so each shows what it produces. Derived rather
// than written: it cannot disagree with reality, because it is reality at build time.
import {
  createEnvironment,
  createStdlib,
  type OpDefinition,
  type SavedProgram,
  typeToString,
} from "@dendrite-lang/core";

import DenCode from "./DenCode.astro";

interface Props {
  category: string;
}

const { category } = Astro.props;

const env = createEnvironment(createStdlib());
const composed = env.forProgram([], []);
if (!composed.ok) throw new Error("the stdlib composes on its own");
const pipeline = composed.environment;

const ops = [...env.language.descriptor.ops.values()].filter((op) => op.category === category);
if (ops.length === 0) throw new Error(`no stdlib ops in category '${category}'`);

const signature = (op: OpDefinition): string => {
  const inputs = op.inputs
    .map((input) => `${input.name}${input.variadic ? "..." : ""}: ${typeToString(input.type)}`)
    .join(", ");
  return `${op.name}(${inputs}) -> ${typeToString(op.output)}`;
};

// "name = value" per output. Examples are literal-only, so running needs no inputs.
const produced = (example: SavedProgram): string[] => {
  const loaded = pipeline.load(example);
  if (!loaded.ok) return [];
  return [...pipeline.run(loaded.program, {})].map(
    ([name, value]) => `${name} = ${JSON.stringify(value)}`,
  );
};
---

{
  ops.map((op) => (
    <section class="op">
      <h2 id={op.name}>{op.name}</h2>
      <p class="signature">
        <code>{signature(op)}</code>
      </p>
      <p>{op.description}</p>
      {op.examples?.map((example) =>
        example.form === "code" ? (
          <>
            <DenCode code={example.source} />
            {/* set:text, so no template whitespace can land inside the <pre>. */}
            <pre
              class="produces"
              set:text={produced(example)
                .map((line) => `→ ${line}`)
                .join("\n")}
            />
          </>
        ) : null,
      )}
    </section>
  ))
}
