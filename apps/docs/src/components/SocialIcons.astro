---
// Starlight's SocialIcons, verbatim but for one thing: the links open in a new tab. A docs
// reader leaving for GitHub should keep the page they were on.
import { Icon } from "@astrojs/starlight/components";
import config from "virtual:starlight/user-config";

const links = config.social || [];
---

{
  links.length > 0 && (
    <>
      {links.map(({ label, href, icon }) => (
        <a {href} rel="me noopener" target="_blank" class="sl-flex">
          <span class="sr-only">{label}</span>
          <Icon name={icon} />
        </a>
      ))}
    </>
  )
}

<style>
  @layer starlight.core {
    a {
      color: var(--sl-color-text-accent);
      padding: 0.5em;
      margin: -0.5em;
    }
    a:hover {
      color: var(--sl-color-white);
    }
  }
</style>
