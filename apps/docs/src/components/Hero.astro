---
// The landing hero, brand round 2's option 5z (brand/CHANGES.md, sheet §24): a band that is
// dark-0 in both themes, the aurora behind it fading into the band, the headline on the left
// and a live Minimal block where the design draws a code well - a program the reader can
// play with above the fold. Markup and CSS are brand/aurora/hero.html's, on the brand's
// tokens (brand/dendrite-tokens.css), with the corrections `.docs/backlog.md` lists for the
// design source; the title, lede and actions are the page's frontmatter.
// The design's buttons carry no icon, so an action's `icon` is not drawn.
// What the band needs from Starlight's own chrome (the nav on the band, the panel it breaks
// out of) is in styles/dendrite.css, because a component's <style> is scoped to its markup.
import fallback from "../../../../brand/assets/aurora-warp-hero-1440x600.svg";
import { scoresExample } from "../examples";
import Live from "./Live";

const { data } = Astro.locals.starlightRoute.entry;
// Starlight's 404 page is a splash page with a hero too: it has no hero title, and no actions.
const { title = data.title, tagline, actions = [] } = data.hero || {};

const { source, ports } = scoresExample;
---

<section class="dn-hero">
  <div class="dn-hero__bg" aria-hidden="true">
    <img src={fallback.src} alt="" class="dn-hero__fallback" />
  </div>
  <div class="dn-hero__inner">
    <div class="dn-hero__copy">
      <h1 id="_top" data-page-title class="dn-hero__title" set:html={title} />
      {tagline && <p class="dn-hero__lede" set:html={tagline} />}
      {
        actions.length > 0 && (
          <div class="dn-hero__actions">
            {actions.map(({ attrs: { class: className, ...attrs } = {}, link, text, variant }) => (
              <a
                class:list={[
                  "dn-btn",
                  variant === "primary" ? "dn-btn--primary" : "dn-btn--ghost",
                  className,
                ]}
                href={link}
                {...attrs}
              >
                {text}
              </a>
            ))}
          </div>
        )
      }
    </div>
    <div class="dn-hero__live">
      <Live client:only="react" source={source} ports={ports} codeMinHeight="11rem" />
    </div>
  </div>
</section>

<script>
  import { mountAurora } from "../../../../brand/aurora/hero";

  // The drifting field takes over from the baked image: mountAurora fades its first frame in,
  // and the mark below lets the styles fade the image out under it. Without JS the image stays.
  const host = document.querySelector<HTMLElement>(".dn-hero__bg");
  if (host) {
    mountAurora(host);
    host.classList.add("is-live");
  }
</script>

<style>
  /* Always the dark band, whatever the page's theme: color-scheme is what the live block's
     light-dark() colours read, so the editor inside is the dark one too. */
  .dn-hero {
    position: relative;
    overflow: hidden;
    background: var(--dn-dark-0);
    color: var(--dn-dark-ink);
    color-scheme: dark;
    print-color-adjust: exact;
  }

  .dn-hero__bg {
    position: absolute;
    inset: 0;
  }

  /* The fade the copy sits on: transparent at 30%, the band's own colour at 95%. */
  .dn-hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 30%, var(--dn-dark-0) 95%);
  }

  .dn-hero__fallback {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* One field at a time. The baked image and the field's first frame are the same picture,
     so the image fades out in the time the frame fades in (the brand's interval, which is
     mountAurora's default) and the field seems to start drifting rather than to blink. When
     motion is not wanted the svg goes and the image stays. The svg is made by the script, so
     it carries no scope attribute: hence :global. */
  @media (prefers-reduced-motion: no-preference) {
    .dn-hero__bg.is-live > .dn-hero__fallback {
      opacity: 0;
      transition: opacity var(--dn-aurora-interval) linear;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dn-hero__bg > :global(svg) {
      display: none !important; /* the script sets display inline */
    }
  }

  .dn-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: end;
    max-width: 1280px;
    /* The design frame's height (1440 x 600): the copy stays in the band's lower part, where
       the fade is, and off the field's brightest lines. */
    min-height: 600px;
    margin: 0 auto;
    padding: 96px 48px 64px;
  }

  /* What the headline's size is measured against. */
  .dn-hero__copy {
    container-type: inline-size;
  }

  .dn-hero__title {
    margin: 0 0 16px;
    font-family: var(--dn-font-display);
    font-weight: var(--dn-font-display-weight);
    /* The design's 56 where the column has room for it, and a tenth of the column where it
       has not: the first line is 9.8em wide, so it always fits, and no word is cut off on a
       phone. */
    font-size: clamp(var(--dn-text-2xl), 10cqi, var(--dn-text-4xl));
    line-height: 1;
    color: var(--dn-dark-ink);
    text-wrap: balance;
  }

  .dn-hero__lede {
    max-width: 40ch;
    margin: 0 0 24px;
    font-family: var(--dn-font-body);
    font-size: var(--dn-text-xl);
    line-height: 1.5;
    color: var(--dn-dark-ink-2);
  }

  .dn-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .dn-btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 16px;
    border-radius: var(--dn-radius-1);
    font-family: var(--dn-font-body);
    font-weight: 600;
    font-size: var(--dn-text-md);
    text-decoration: none;
    transition: background var(--dn-motion-fast) var(--dn-ease);
  }

  .dn-btn--primary {
    background: var(--dn-periwinkle);
    color: var(--dn-dark-0);
  }

  .dn-btn--primary:hover {
    background: var(--dn-iris-300);
  }

  .dn-btn--ghost {
    border: 1px solid var(--dn-dark-ink-2);
    color: var(--dn-dark-ink);
  }

  .dn-btn--ghost:hover {
    background: var(--dn-dark-1);
  }

  .dn-btn:focus-visible {
    outline: 2px solid var(--dn-periwinkle);
    outline-offset: 2px;
  }

  /* The live block brings its own margin for prose; in the band the grid places it. */
  .dn-hero__live :global(.live) {
    margin: 0;
  }

  @media (max-width: 960px) {
    .dn-hero__inner {
      /* minmax(0, ...) and not a bare 1fr: the live block's longest code line is its
         min-content width, and it would widen the column past the window. */
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      padding: 64px 24px 40px;
    }
  }
</style>
