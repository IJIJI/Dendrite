---
// The splash hero, Starlight's own with two changes: the wordmark stands where the title
// text was (still the page's <h1>, for the outline and the skip link), and a live Minimal
// block stands where the image was - a program the reader can play with above the fold.
// Everything else (tagline, actions, the grid) is Starlight's markup and CSS, copied
// because a component's <style> is scoped to its own markup.
import { LinkButton } from "@astrojs/starlight/components";
import { Image } from "astro:assets";

import dark from "../assets/dendrite-wordmark-dark.svg";
import light from "../assets/dendrite-wordmark.svg";
import Live from "./Live";

const { data } = Astro.locals.starlightRoute.entry;
const { tagline, actions = [] } = data.hero || {};

const source = `// Change $threshold; only what depends on it recomputes.
let scores = [4, 8, 15, 16, 23]
let high   = Filter(scores, item => item > $threshold)
output count = Length(high)
output any   = Some(scores, item => item > $threshold)`;
const ports = {
  inputs: [{ name: "threshold", type: { kind: "name", name: "number" }, default: 10 }],
  outputs: [
    { name: "count", type: { kind: "name", name: "number" } },
    { name: "any", type: { kind: "name", name: "boolean" } },
  ],
} as const;
---

<div class="hero">
  <div class="hero-live">
    <Live client:only="react" source={source} ports={ports} />
  </div>
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id="_top" data-page-title>
        <Image src={light} alt="Dendrite" class="wordmark dark:sl-hidden" loading="eager" />
        <Image src={dark} alt="Dendrite" class="wordmark light:sl-hidden" loading="eager" />
      </h1>
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ),
          )}
        </div>
      )
    }
  </div>
</div>

<style>
  @layer starlight.core {
    .hero {
      display: grid;
      grid-template-columns: 100%;
      align-items: center;
      gap: 1.5rem;
      padding-bottom: 1rem;
    }

    .hero-live {
      width: 100%;
      margin-inline: auto;
    }

    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
      text-align: center;
    }

    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .copy > * {
      max-width: 50ch;
    }

    h1 {
      margin: 0;
      line-height: 0;
    }

    .wordmark {
      width: min(100%, 22rem);
      height: auto;
    }

    .tagline {
      font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
      color: var(--sl-color-gray-2);
    }

    .actions {
      gap: 1rem 2rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    @media (min-width: 50rem) {
      .hero {
        grid-template-columns: 5fr 6fr;
        gap: 4%;
        padding-block: clamp(2.5rem, calc(1rem + 10vmin), 8rem);
      }

      .hero-live {
        order: 2;
      }

      .stack {
        text-align: start;
      }

      .copy {
        align-items: flex-start;
      }

      .actions {
        justify-content: flex-start;
      }
    }
  }
</style>
