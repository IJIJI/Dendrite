{
  "name": "dendrite",
  "private": true,
  "description": "Dendrite monorepo: the language core, the editor, and the apps that host it.",
  "license": "MPL-2.0",
  "packageManager": "yarn@4.15.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological --verbose run build",
    "test": "yarn workspaces foreach --all --verbose run test",
    "typecheck": "yarn workspaces foreach --all --verbose run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
