{
  "name": "@dendrite-lang/link",
  "version": "0.3.0",
  "description": "Drive a Dendrite ProgramInstance across a channel: a host serves one, an editor connects a replica. The message shapes are Dendrite's; the pipe is the host's.",
  "keywords": [
    "dendrite",
    "remote",
    "websocket",
    "messageport",
    "replica",
    "dataflow"
  ],
  "homepage": "https://ijiji.github.io/Dendrite/host/packages/link/",
  "bugs": {
    "url": "https://github.com/IJIJI/Dendrite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IJIJI/Dendrite.git",
    "directory": "packages/link"
  },
  "license": "MPL-2.0",
  "author": "IJssel K <ijssel@synapt.nl> (https://synapt.net/)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example": "tsx --tsconfig tsconfig.examples.json examples/serve-ws.ts"
  },
  "peerDependencies": {
    "@dendrite-lang/core": "^0.3.0"
  },
  "devDependencies": {
    "@dendrite-lang/core": "workspace:^",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  }
}
