{
  "name": "@dendrite-lang/editor",
  "version": "0.1.0",
  "description": "Dendrite editor: framework-free session, CodeMirror adapter, document model and stores; React compound components under ./react.",
  "keywords": [
    "dendrite",
    "editor",
    "codemirror",
    "react",
    "dataflow",
    "dsl",
    "code-editor"
  ],
  "homepage": "https://ijiji.github.io/Dendrite/host/packages/editor/",
  "bugs": {
    "url": "https://github.com/IJIJI/Dendrite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IJIJI/Dendrite.git",
    "directory": "packages/editor"
  },
  "license": "MPL-2.0",
  "author": "IJssel K <ijssel@synapt.nl> (https://synapt.net/)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "dist",
    "style.css",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@dendrite-lang/core": "^0.1.0",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "codemirror": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dendrite-lang/core": "workspace:^",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
